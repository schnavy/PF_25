---
import {getCollection} from 'astro:content';
import {getImage} from 'astro:assets';

// One static page per project that has a desc.md - reachable at
// `${BASE_URL}<project-folder-name>/`. Linked from the "?" mark on the
// curtain (see .project-info in index.astro / js/script.js).
export async function getStaticPaths() {
    const projectEntries = await getCollection('projects');
    return projectEntries.map((entry) => ({
        params: {slug: entry.id.split('/')[0]},
        props: {entry}
    }));
}

const {entry} = Astro.props;
const slug = Astro.params.slug;
const {Content} = await entry.render();

// Downscale + convert to webp at build time, same treatment as the curtain
// images on the home page, scoped to just this project's folder.
const projectImageGlob = import.meta.glob('/src/content/projects/*/*.{jpg,jpeg,png,webp,gif}', {
    eager: true,
    import: 'default'
});

const projectImageEntries = Object.entries(projectImageGlob)
    .filter(([path]) => path.split('/').at(-2) === slug)
    .sort(([a], [b]) => a.localeCompare(b));

const images = await Promise.all(projectImageEntries.map(async ([path, image]) => {
    const optimized = await getImage({
        // @ts-ignore - image is the imported ImageMetadata object
        src: image,
        format: 'webp',
        // @ts-ignore
        width: Math.min(image.width, 1920),
        quality: 75
    });
    const filename = path.split('/').pop().replace(/\.[^.]+$/, '') + '.jpg';
    return {src: optimized.src, filename};
}));
const [firstImage, ...restImages] = images;

// url is written as a markdown link, e.g. "[Visit Web Version](https://...)";
// fall back to using the raw value as both label and href if it isn't.
const urlMatch = entry.data.url?.match(/^\[(.*)]\((.*)\)$/);
const linkLabel = urlMatch ? urlMatch[1] : entry.data.url;
const linkHref = urlMatch ? urlMatch[2] : entry.data.url;

// Generate random favicon number
const rand = Math.floor(Math.random() * 6);
---

<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8"/>
        <meta http-equiv="X-UA-Compatible" content="IE=edge"/>
        <meta name="description" content={`${entry.data.title} (${entry.data.year}) by David Wahrenburg.`}/>
        <meta name="author" content="David Wahrenburg"/>
        <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
        <link rel="stylesheet" href={`${import.meta.env.BASE_URL}css/style.css`}/>
        <link rel="shortcut icon" href={`${import.meta.env.BASE_URL}images/favicon_${rand}.png`} type="image/x-icon"/>
        <title>{entry.data.title} — David Wahrenburg</title>

        <script define:vars={{baseUrl: import.meta.env.BASE_URL}}>
            window.baseUrl = baseUrl;

                // Random link colors, matching the home page - the back arrow is
                // excluded so it always stays legible against the images.
                const linkColors = [
                    '#d20000', // red
                    '#00b475', // turquoise
                    '#0066ff', // blue
                    '#f64900', // light salmon
                    '#b99a00', // yellow
                    '#8816b4', // purple
                    '#cc7b00', // peach
                    '#903caf'  // lavender
                    ];

                const randomColor = () => linkColors[Math.floor(Math.random() * linkColors.length)];

                function changeColors() {
                    document.querySelectorAll('a:not(.detail-back-btn)').forEach(link => {
                        link.style.color = randomColor();
                        });

                    const infoBox = document.getElementById('project-detail-info');
                    if (infoBox) infoBox.style.borderColor = randomColor();

                    /*document.querySelectorAll('hr').forEach(hr => {
                        hr.style.borderColor = randomColor();
                        });*/
                    }
                document.addEventListener('DOMContentLoaded', changeColors);

                // Matomo Analytics
                var _paq = window._paq = window._paq || [];
                _paq.push(['trackPageView']);
                _paq.push(['enableLinkTracking']);
                (function () {
                    var u = "//webstat.davidwahrenburg.de/";
                    _paq.push(['setTrackerUrl', u + 'matomo.php']);
                    _paq.push(['setSiteId', '1']);
                    var d = document,
                        g = d.createElement('script'),
                        s = d.getElementsByTagName('script')[0];
                    g.async = true;
                    g.src = u + 'matomo.js';
                    s.parentNode.insertBefore(g, s);
                    })();
        </script>
    </head>

    <body>
        <div id="project-detail" class="open">
            <div id="project-detail-info" class="info-box">
                <a id="project-detail-back" class="detail-back-btn" href={import.meta.env.BASE_URL}
                   aria-label="Back">↩ ‘-‘_@_</a><br/>
                <div id="project-detail-content">
                    <div class="project-meta">
                        <h1>{entry.data.title}</h1>
                        <div class="level-1">Year: {entry.data.year}</div>
                        <div class="level-1">{entry.data.medium}</div>
                        {entry.data.url &&
                                <div class="level-1">
                                    <a href={linkHref} target="_blank" rel="noopener noreferrer">{linkLabel}</a>
                                </div>
                        }
                        {entry.data.collaborators.length > 0 &&
                                <div class="level-1">Together with:<br/>
                                    {entry.data.collaborators.join(', ')}
                                </div>
                        }
                    </div>
                    <!--<hr>-->
                    <div class="hhrr">----------------------------------</div>
                    <Content/>
                </div>
            </div>
            <div id="project-detail-gallery-wrapper">
                <div id="project-detail-gallery">
                    <div id="project-detail-first-image">
                        {firstImage && <img src={firstImage.src} alt={firstImage.filename}/>}
                    </div>
                    <div id="project-detail-image-flow">
                        {restImages.map((image) => <img src={image.src} alt={image.filename}/>)}
                    </div>
                </div>
            </div>
        </div>
    </body>
</html>
