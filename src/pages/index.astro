---
import {getCollection} from 'astro:content';
import {getImage} from 'astro:assets';

// Get all content
const intro = await getCollection('sections').then(entries =>
    entries.find(entry => entry.id === 'intro.md')
);
const timeline = await getCollection('sections').then(entries =>
    entries.find(entry => entry.id === 'timeline.md')
);

// Curtain images live in per-project folders alongside the rest of the
// projects collection:
//   src/content/projects/<project>/img1.jpg, img2.jpg, desc.md (optional)
// Projects (and images within a project) are kept in a fixed alphabetical
// order - only each column's starting position is randomized client-side
// (see script.js). A project's desc.md (title/year/collaborators + body) is
// rendered below via the "projects" content collection and only shown for
// projects that actually have one.
const curtainImageGlob = import.meta.glob('/src/content/projects/*/*.{jpg,jpeg,png,webp,gif}', {
    eager: true,
    import: 'default'
});

const projectSlugOf = (path) => path.split('/').at(-2);
const projectSlugs = [...new Set(Object.keys(curtainImageGlob).map(projectSlugOf))].sort();

// Downscale + convert to webp at build time so the client never has to
// download full-resolution originals just to fill a curtain column.
const curtainImages = (await Promise.all(
    projectSlugs.map((slug) => {
        const projectImageEntries = Object.entries(curtainImageGlob)
            .filter(([path]) => projectSlugOf(path) === slug)
            .sort(([a], [b]) => a.localeCompare(b));

        return Promise.all(projectImageEntries.map(async ([path, image]) => {
            const optimized = await getImage({
                // @ts-ignore - image is the imported ImageMetadata object
                src: image,
                format: 'webp',
                // @ts-ignore
                width: Math.min(image.width, 1920),
                quality: 75
            });
            const filename = path.split('/').pop().replace(/\.[^.]+$/, '') + '.jpg';
            const landscape = optimized.attributes.width > optimized.attributes.height;
            return {src: optimized.src, filename, project: slug, landscape};
        }));
    })
)).flat();

// Projects with a desc.md each get their own static detail page (see
// src/pages/[slug].astro) - the "?" mark links there. describedProjectSlugs
// is just used client-side to decide when to show the "?" (js/script.js).
const projectEntries = await getCollection('projects');
const describedProjectSlugs = projectEntries.map((entry) => entry.id.split('/')[0]);

// Sound files paths (served from public folder)
const soundPaths = [
    `${import.meta.env.BASE_URL}sounds/plop1.mp3`,
    `${import.meta.env.BASE_URL}sounds/plop2.mp3`,
    `${import.meta.env.BASE_URL}sounds/plop3.mp3`,
    `${import.meta.env.BASE_URL}sounds/plop4.mp3`,
    `${import.meta.env.BASE_URL}sounds/plop5.mp3`,
];

// Render markdown content
const {Content: IntroContent} = intro ? await intro.render() : {Content: null};

// Generate random favicon number
const rand = Math.floor(Math.random() * 6);
---

<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8"/>
        <meta http-equiv="X-UA-Compatible" content="IE=edge"/>
        <meta name="description"
              content="Bremen-based graphic designer and programmer, with a focus on experimental web development."/>
        <meta name="author" content="David Wahrenburg"/>
        <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
        <link rel="stylesheet" href={`${import.meta.env.BASE_URL}css/style.css`}/>
        <link rel="shortcut icon" href={`${import.meta.env.BASE_URL}images/favicon_${rand}.png`} type="image/x-icon"/>
        <title>David Wahrenburg</title>

        <script define:vars={{curtainImages, soundPaths, describedProjects: describedProjectSlugs, baseUrl: import.meta.env.BASE_URL}}>
            // Curtain images (fixed order) + sounds, read by js/script.js.
            // describedProjects lists which project slugs have a desc.md and
            // therefore their own detail page at `${baseUrl}${slug}/`.
            window.curtainImages = curtainImages;
            window.soundPaths = soundPaths;
            window.describedProjects = describedProjects;
            window.baseUrl = baseUrl;

            // Random link colors - each link gets a different color
            const linkColors = [
                '#d20000', // red
                '#00b475', // turquoise
                '#0066ff', // blue
                '#f64900', // light salmon
                '#b99a00', // yellow
                '#8816b4', // purple
                '#cc7b00', // peach
                '#903caf'  // lavender
            ];

            const randomColor = () => linkColors[Math.floor(Math.random() * linkColors.length)];

            function changeColors() {
                const links = document.querySelectorAll('a');
                links.forEach(link => {
                    link.style.color = randomColor();
                });

                // Shared per-load colors, reused by the project-info "?" marks
                const topBorderColor = randomColor();
                const dashedBorderColor = randomColor();
                const middleMarkColor = randomColor();

                const textContainer = document.getElementById('text-container');
                textContainer.style.borderColor = topBorderColor;

                const hrs = document.querySelectorAll('hr');
                hrs.forEach(hr => {
                    hr.style.borderColor = dashedBorderColor;
                });

                document.querySelectorAll('.project-info').forEach(box => {
                    box.style.borderTopColor = topBorderColor;
                });
                const leftMark = document.querySelector('[data-side="left"] .project-info-mark');
                const rightMark = document.querySelector('[data-side="right"] .project-info-mark');
                const middleMark = document.querySelector('[data-side="middle"] .project-info-mark');
                if (leftMark) leftMark.style.color = topBorderColor;
                if (rightMark) rightMark.style.color = dashedBorderColor;
                if (middleMark) middleMark.style.color = middleMarkColor;
            }

            document.addEventListener('DOMContentLoaded', changeColors);

            // Matomo Analytics
            var _paq = window._paq = window._paq || [];
            _paq.push(['trackPageView']);
            _paq.push(['enableLinkTracking']);
            (function () {
                var u = "//webstat.davidwahrenburg.de/";
                _paq.push(['setTrackerUrl', u + 'matomo.php']);
                _paq.push(['setSiteId', '1']);
                var d = document,
                    g = d.createElement('script'),
                    s = d.getElementsByTagName('script')[0];
                g.async = true;
                g.src = u + 'matomo.js';
                s.parentNode.insertBefore(g, s);
            })();
        </script>
    </head>

    <body>
        <div id="text-container" class="info-box">
            <div id="text-container-content">
                <div class="intro-content">
                    {IntroContent &&
                            <IntroContent/>}
                </div>
                <br/>
                <span id="impressum-btn">Imprint</span>
                <div class="imprint-container">
                    <br/>
                    Responsible for shown content, design and development of this website:<br/>
                    David Wahrenburg<br/>
                    Rolandstraße 11<br/>
                    D-28199 Bremen<br/>
                    ©{new Date().getFullYear()} all rights
                    reserved
                    <br/><br/>
                    Free Palestine! 🍉
                </div>
            </div>
        </div>

        <div id="grid"></div>

        <div id="image-container">
            {curtainImages.length >= 2 && (
                    <>
                    <div class="curtain-column" data-column="left">
                        <img src="" alt=""/>
                        <div class="image-filename"></div>
                        <a class="project-info" data-side="left" href="#">
                            <span class="project-info-mark">?</span>
                        </a>
                    </div>
                    <div class="curtain-column" data-column="middle">
                        <img src="" alt=""/>
                        <div class="image-filename"></div>
                        <a class="project-info" data-side="middle" href="#">
                            <span class="project-info-mark">?</span>
                        </a>
                    </div>
                    <div class="curtain-column" data-column="right">
                        <img src="" alt=""/>
                        <div class="image-filename"></div>
                        <a class="project-info" data-side="right" href="#">
                            <span class="project-info-mark">?</span>
                        </a>
                    </div>
                    </>
            )}
        </div>

        <script is:inline src={`${import.meta.env.BASE_URL}js/script.js`}></script>
    </body>
</html>
